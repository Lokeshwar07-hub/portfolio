"var Component=(()=>{var p=Object.create;var s=Object.defineProperty;var g=Object.getOwnPropertyDescriptor;var u=Object.getOwnPropertyNames;var m=Object.getPrototypeOf,f=Object.prototype.hasOwnProperty;var y=(n,e)=>()=>(e||n((e={exports:{}}).exports,e),e.exports),w=(n,e)=>{for(var r in e)s(n,r,{get:e[r],enumerable:!0})},o=(n,e,r,i)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let a of u(e))!f.call(n,a)&&a!==r&&s(n,a,{get:()=>e[a],enumerable:!(i=g(e,a))||i.enumerable});return n};var b=(n,e,r)=>(r=n!=null?p(m(n)):{},o(e||!n||!n.__esModule?s(r,\"default\",{value:n,enumerable:!0}):r,n)),k=n=>o(s({},\"__esModule\",{value:!0}),n);var d=y((S,l)=>{l.exports=_jsx_runtime});var v={};w(v,{default:()=>h});var t=b(d());function c(n){let e={code:\"code\",h1:\"h1\",h2:\"h2\",h3:\"h3\",li:\"li\",ol:\"ol\",p:\"p\",pre:\"pre\",strong:\"strong\",table:\"table\",tbody:\"tbody\",td:\"td\",th:\"th\",thead:\"thead\",tr:\"tr\",ul:\"ul\",...n.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(e.h1,{children:\"Deep Agents: Why Most AI Agents Are Shallow (And How to Fix It)\"}),`\n`,(0,t.jsx)(e.p,{children:\"A complete guide to building AI agents that actually plan, delegate, and remember. Learn the architecture behind Claude Code, Deep Research, and how to build production-ready deep agents with LangChain.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Table of Contents\"}),`\n`,(0,t.jsxs)(e.ol,{children:[`\n`,(0,t.jsx)(e.li,{children:\"The Problem: Why Most Agents Are Shallow\"}),`\n`,(0,t.jsx)(e.li,{children:\"What Makes an Agent Deep?\"}),`\n`,(0,t.jsx)(e.li,{children:\"Deep Agents in the Wild\"}),`\n`,(0,t.jsx)(e.li,{children:\"Pillar 1: Planning Tools\"}),`\n`,(0,t.jsx)(e.li,{children:\"Pillar 2: File Systems\"}),`\n`,(0,t.jsx)(e.li,{children:\"Pillar 3: Subagents\"}),`\n`,(0,t.jsx)(e.li,{children:\"Pillar 4: Detailed System Prompts\"}),`\n`,(0,t.jsx)(e.li,{children:\"The Bottom Line\"}),`\n`]}),`\n`,(0,t.jsx)(e.h2,{children:\"The Problem: Why Most Agents Are Shallow\"}),`\n`,(0,t.jsx)(e.p,{children:'You build an AI agent. It can search the web, analyze data, even write code. You give it a task: \"Research the top 5 AI companies hiring in San Francisco, analyze their job openings, and write personalized cover letters for each.\"'}),`\n`,(0,t.jsx)(e.p,{children:\"Your agent searches once. Gets overwhelmed. Writes one generic cover letter. Forgets companies 2 through 5. Fails completely.\"}),`\n`,(0,t.jsx)(e.p,{children:\"This is what I call a shallow agent. Using an LLM to call tools in a loop is the simplest form of an agent, but this architecture yields agents that fail to plan and act over longer, more complex tasks.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-text\",children:`User: \"Find me jobs and write cover letters for 5 companies\"\\r\n\\r\nShallow Agent Process:\\r\n\\u2192 Searches: \"AI companies SF hiring\"\\r\n\\u2192 Gets 50 results, context starts filling up\\r\n\\u2192 Picks first company, writes generic letter\\r\n\\u2192 Tries to continue but context is full of search results\\r\n\\u2192 Forgets the task had 5 companies\\r\n\\u2192 Returns incomplete work\\r\n\\r\nResult: FAILURE\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"Now watch what happens with a deep agent:\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-text\",children:`User: \"Find me jobs and write cover letters for 5 companies\"\\r\n\\r\nDeep Agent Process:\\r\n\\u2192 Writes TODO list:\\r\n   1. Search for AI companies in SF\\r\n   2. Research each company (spawn subagent for each)\\r\n   3. Find job openings for each\\r\n   4. Write personalized cover letters\\r\n\\u2192 Executes step 1: Searches broadly\\r\n\\u2192 Stores company list in companies.md file\\r\n\\u2192 For each company:\\r\n   \\u2192 Spawns research subagent with isolated context\\r\n   \\u2192 Subagent deep-dives on that company\\r\n   \\u2192 Stores findings in company_X_research.md\\r\n\\u2192 Reads research files\\r\n\\u2192 Writes 5 personalized, specific cover letters\\r\n\\r\nResult: SUCCESS\n`})}),`\n`,(0,t.jsx)(e.h2,{children:\"What Makes an Agent Deep?\"}),`\n`,(0,t.jsx)(e.p,{children:\"The difference is not the core algorithm. Both agents are just LLMs running in a loop calling tools. The difference is the architecture around that loop.\"}),`\n`,(0,t.jsx)(e.p,{children:\"The four pillars are:\"}),`\n`,(0,t.jsxs)(e.ol,{children:[`\n`,(0,t.jsx)(e.li,{children:\"Planning - breaks down the task before starting\"}),`\n`,(0,t.jsx)(e.li,{children:\"File system - manages context by offloading to files\"}),`\n`,(0,t.jsx)(e.li,{children:\"Subagents - delegates specialized work\"}),`\n`,(0,t.jsx)(e.li,{children:\"Detailed prompts - tells the model how to use the other three\"}),`\n`]}),`\n`,(0,t.jsx)(e.h2,{children:\"Deep Agents in the Wild\"}),`\n`,(0,t.jsx)(e.p,{children:\"Claude Code, OpenAI Deep Research, and Manus all converged on the same pattern.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Claude Code's TODO list tool is effectively a no-op. It does not execute work. It just stores planning steps. That is the point: it forces the agent to think before acting.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`from langchain_core.tools import tool\\r\n\\r\n@tool\\r\ndef write_todos(todos: list[str]) -> str:\\r\n\t\"\"\"Write or update your TODO list.\"\"\"\\r\n\treturn f\"Updated TODOs: {', '.join(todos)}\"\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"Subagents matter because they keep context isolated and clean. The main agent orchestrates without getting bogged down in the details.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-mermaid\",children:`graph TB\\r\n\tsubgraph Shallow[Shallow Agent Workflow]\\r\n\t\tS_Start([User]) --> S_Agent[Agent]\\r\n\t\tS_Agent --> S_Tool[Tool]\\r\n\t\tS_Tool --> S_Resp([Response])\\r\n\tend\\r\n\\r\n\tsubgraph Deep[Deep Agent Workflow]\\r\n\t\tD_Start([User]) --> D_Plan[Planning]\\r\n\t\tD_Plan --> D_Loop{Execution Loop}\\r\n\t\tD_Loop -->|Read/Write| D_Files[(Files)]\\r\n\t\tD_Loop -->|Delegate| D_Subs[[Subagents]]\\r\n\t\tD_Loop -->|Direct| D_Tools[Tools]\\r\n\t\tD_Files & D_Subs & D_Tools --> D_Synth[Synthesis]\\r\n\t\tD_Synth --> D_Resp([Response])\\r\n\tend\n`})}),`\n`,(0,t.jsx)(e.h2,{children:\"Pillar 1: Planning Tools\"}),`\n`,(0,t.jsx)(e.p,{children:\"The most important tool in a deep agent does almost nothing. It just stores a list of todos.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`@tool\\r\ndef write_todos(todos: list[str]) -> str:\\r\n\t\"\"\"\\r\n\tWrite or update your TODO list.\\r\n\\r\n\tUse this to break down complex tasks into steps, track progress,\\r\n\tand update the plan as new information emerges.\\r\n\t\"\"\"\\r\n\treturn f\"Updated TODOs: {', '.join(todos)}\"\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"The value is not in what the tool does. The value is in making the LLM call it.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Pillar 2: File Systems\"}),`\n`,(0,t.jsx)(e.p,{children:\"You cannot keep everything in the context window forever. Deep agents write findings to files as they discover them, then read only what they need for the current step.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`# Research a company and store the result\\r\nresearch = agent.internet_search(\"OpenAI company culture\")\\r\nagent.write_file(\"openai_research.md\", research)\\r\n\\r\n# Later, load just what you need\\r\nresearch = agent.read_file(\"openai_research.md\")\\r\nletter = generate_cover_letter(job_posting, research)\n`})}),`\n`,(0,t.jsx)(e.h2,{children:\"Pillar 3: Subagents\"}),`\n`,(0,t.jsx)(e.p,{children:\"Subagents allow parallel work while keeping context isolated.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Without subagents, the main agent context fills with company research, TODOs, and outputs. With subagents, each company gets its own focused context and its own file.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Pillar 4: Detailed System Prompts\"}),`\n`,(0,t.jsx)(e.p,{children:\"The final pillar is often overlooked. Detailed prompts tell the agent how to plan, when to delegate, and when to store work in files.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"The Bottom Line\"}),`\n`,(0,t.jsx)(e.p,{children:\"The solution is not a different algorithm. It is the same algorithm with four architectural additions: planning, files, subagents, and better prompts.\"}),`\n`,(0,t.jsx)(e.p,{children:`If you want an agent that can handle real work, you need all four.\\r\nA complete guide to building AI agents that actually plan, delegate, and remember. Learn the architecture behind Claude Code, Deep Research, and how to build production-ready deep agents with LangChain.`}),`\n`,(0,t.jsx)(e.h2,{children:\"Deep Agents in the Wild\"}),`\n`,(0,t.jsx)(e.p,{children:\"Claude Code changed the game. Not because it invented something new, but because people started using it for tasks way beyond coding. Someone used it to plan a wedding, another to research investments, another to write a novel outline.\"}),`\n`,(0,t.jsx)(e.p,{children:\"What does Claude Code have that makes this possible? A long, detailed system prompt with explicit instructions on every tool and workflow patterns for different task types. A TODO list tool that's essentially a no-op but forces the agent to plan before acting. Subagent spawning for context isolation. And file system access for persistent memory.\"}),`\n`,(0,t.jsx)(e.p,{children:\"OpenAI's Deep Research uses the same pattern: planning phase before execution, intermediate results storage, parallel research threads, and detailed methodology instructions. Manus makes heavy use of file systems for agent memory and context engineering at scale.\"}),`\n`,(0,t.jsx)(e.p,{children:\"All three independently arrived at the same architecture. This is not coincidence. This is the architecture that works for complex, multi-step tasks. The core insight is that the algorithm is the same \\u2014 an LLM running in a loop calling tools \\u2014 but the difference is in what surrounds that loop: detailed system prompts, planning tools, file systems, and subagents.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Shallow vs Deep: Code Comparison\"}),`\n`,(0,t.jsx)(e.p,{children:(0,t.jsx)(e.strong,{children:\"Shallow agent pattern:\"})}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`def shallow_agent(task):\\r\n    history = []\\r\n    while not done:\\r\n        thought = llm.generate(task + history)\\r\n        action = select_tool(thought)\\r\n        result = execute(action)\\r\n        history.append(result)\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"Everything crammed into one context. No plan. No way to delegate. No persistent storage. Works for simple tasks, fails on anything complex.\"}),`\n`,(0,t.jsx)(e.p,{children:(0,t.jsx)(e.strong,{children:\"Deep agent pattern:\"})}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`def deep_agent(task):\\r\n    todos = agent.write_todos(task)\\r\n    for subtask in todos:\\r\n        if needs_deep_focus(subtask):\\r\n            subagent = spawn_subagent(task=subtask)\\r\n            result = subagent.run()\\r\n            filesystem.write(f\"{subtask}.md\", result)\\r\n        else:\\r\n            result = execute_tools(subtask)\\r\n        todos = agent.update_todos(result)\\r\n    research = filesystem.read_all(\"*.md\")\\r\n    return synthesize(research)\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"Planning, file storage, subagent delegation, dynamic adaptation. The same core loop, but the architecture around it makes all the difference.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"How Deep Agents Compare to Traditional Ones\"}),`\n`,(0,t.jsxs)(e.table,{children:[(0,t.jsx)(e.thead,{children:(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.th,{children:\"Capability\"}),(0,t.jsx)(e.th,{children:\"Shallow Agent\"}),(0,t.jsx)(e.th,{children:\"Deep Agent\"})]})}),(0,t.jsxs)(e.tbody,{children:[(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Planning\"}),(0,t.jsx)(e.td,{children:\"Reactive, no explicit plan\"}),(0,t.jsx)(e.td,{children:\"Proactive with TODO lists\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Memory\"}),(0,t.jsx)(e.td,{children:\"Conversation history only\"}),(0,t.jsx)(e.td,{children:\"Persistent file system\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Context Management\"}),(0,t.jsx)(e.td,{children:\"Everything in prompt\"}),(0,t.jsx)(e.td,{children:\"Offloaded to files\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Delegation\"}),(0,t.jsx)(e.td,{children:\"Cannot delegate\"}),(0,t.jsx)(e.td,{children:\"Spawns specialized subagents\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Task Breakdown\"}),(0,t.jsx)(e.td,{children:\"None, tries everything at once\"}),(0,t.jsx)(e.td,{children:\"Multi-step decomposition\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Adaptation\"}),(0,t.jsx)(e.td,{children:\"Rigid execution\"}),(0,t.jsx)(e.td,{children:\"Updates plan dynamically\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Success Rate (Complex)\"}),(0,t.jsx)(e.td,{children:\"~40%\"}),(0,t.jsx)(e.td,{children:\"~85%\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Cost/Task\"}),(0,t.jsx)(e.td,{children:\"$0.05 avg\"}),(0,t.jsx)(e.td,{children:\"$0.85 avg\"})]}),(0,t.jsxs)(e.tr,{children:[(0,t.jsx)(e.td,{children:\"Time/Task\"}),(0,t.jsx)(e.td,{children:\"45s avg\"}),(0,t.jsx)(e.td,{children:\"2.5min avg\"})]})]})]}),`\n`,(0,t.jsx)(e.p,{children:\"Deep agents cost roughly 4x more and take 3x longer per task. But they succeed on complex tasks 85% of the time compared to 40% for shallow agents. The tradeoff is thoroughness for cost \\u2014 use deep agents when quality matters more than speed.\"}),`\n`,(0,t.jsx)(e.p,{children:(0,t.jsx)(e.strong,{children:\"When to use each:\"})}),`\n`,(0,t.jsxs)(e.ul,{children:[`\n`,(0,t.jsxs)(e.li,{children:[(0,t.jsx)(e.strong,{children:\"Traditional agents:\"}),\" simple single-step tasks, FAQ bots, simple search, data lookup, calculator. Speed and cost are critical, context fits easily in one prompt.\"]}),`\n`,(0,t.jsxs)(e.li,{children:[(0,t.jsx)(e.strong,{children:\"Deep agents:\"}),\" complex multi-step tasks requiring planning, research, coding projects, analysis, report generation. Quality matters more than speed, large amounts of context needed.\"]}),`\n`]}),`\n`,(0,t.jsx)(e.h2,{children:\"Production Deployment\"}),`\n`,(0,t.jsx)(e.p,{children:\"Deploying deep agents to production requires additional considerations beyond the development setup.\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"LangSmith integration:\"}),\" Deep agents work seamlessly with LangSmith for observability. Set \",(0,t.jsx)(e.code,{children:\"LANGCHAIN_TRACING_V2=true\"}),\" and every agent run is automatically traced \\u2014 you can see the full reasoning chain, every tool call, every subagent execution, and the total cost per session.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Cost management:\"}),\" Because deep agents are thorough, they can be expensive without guardrails. Set max_iterations limits to prevent infinite loops. Use cheaper models for subagents \\u2014 GPT-4o-mini for research tasks, GPT-4o only for synthesis. Implement budget tracking middleware that monitors token usage and alerts when costs exceed thresholds.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Error handling:\"}),\" Add retry logic for failed tool calls, timeout guards for long-running operations, and fallback responses when the agent fails completely. Log all failures for post-mortem analysis.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Testing strategy:\"}),\" Deep agents are non-deterministic. Unit tests can verify specific tool calls, but end-to-end tests need statistical evaluation. Run each test 3-5 times and measure pass rates rather than binary pass/fail.\"]}),`\n`,(0,t.jsx)(e.h2,{children:\"Common Mistakes\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Using deep agents for simple tasks.\"}),` Don't use a deep agent for \"What is 2+2?\" \\u2014 a simple LLM call costs $0.001 and takes 1 second. Deep agents are for complex, multi-step work.`]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Vague subagent descriptions.\"}),' Be specific about what a subagent does so the router knows when to pick it. \"Helps with stuff\" is useless. \"Analyzes CSV data and generates visualizations\" tells the agent exactly when to delegate.']}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Not encouraging planning.\"}),\" Your prompt must explicitly demand a TODO list for complex tasks. Without it, the agent skips planning and fails.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Ignoring file systems.\"}),\" Without files, context overflow is inevitable. Every research result, every analysis, every intermediate step should go to a file.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"No cost controls.\"}),\" Deep agents are thorough, which means they can be expensive. Set max iteration limits, use cheaper models for subagents, and implement budget tracking.\"]}),`\n`,(0,t.jsx)(e.h2,{children:\"The Hard Problems\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Context window management.\"}),\" Even with files, tool history grows. Use aggressive eviction thresholds and summarization to keep the active context focused on what matters for the current step.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Infinite loops.\"}),\" Agents can get stuck retrying the same failed search or tool call. Set max iteration limits and include anti-loop rules in your system prompts. Track iteration counts through LangSmith to catch runaway agents.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Cost management.\"}),\" Deep agents are thorough, which means they can be expensive without guardrails. Use cheaper models for subagents, set budget limits, and monitor costs per session.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Non-determinism.\"}),\" The same task can produce different results each time due to LLM temperature and timing. Use statistical evaluation rather than expecting identical outputs. Run multiple trials for critical tasks.\"]}),`\n`,(0,t.jsx)(e.h2,{children:\"Framework Landscape\"}),`\n`,(0,t.jsx)(e.p,{children:\"Several frameworks implement the deep agent pattern:\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"LangChain Deep Agents\"}),\" \\u2014 a complete toolkit out of the box with built-in planning, file systems, and subagents. Easy to start, opinionated architecture.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"LangGraph\"}),\" \\u2014 graph-based framework for full control. Maximum flexibility but you must build planning, files, and delegation yourself. Best for custom workflows.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"CrewAI\"}),\" \\u2014 production-focused multi-agent framework with strong team collaboration patterns and good planning support but limited file system capabilities.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"AutoGen\"}),\" \\u2014 Microsoft's conversational multi-agent framework with strong subagent support but no built-in file systems or planning tools.\"]}),`\n`,(0,t.jsx)(e.p,{children:\"The right choice depends on your needs. LangChain Deep Agents is the fastest path to a working deep agent. LangGraph gives you the most control for production deployments. CrewAI excels at team-based collaboration patterns.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Migrating from Shallow to Deep\"}),`\n`,(0,t.jsx)(e.p,{children:\"The simplest migration path: start with a traditional agent and add capabilities incrementally. Add planning first via a write_todos tool and prompt instructions to use it. Then add a file system for context management. Then add subagents for task delegation. Each step gives measurable improvement in task completion rates.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`# Step 1: Add planning\\r\nsystem_prompt += \"\\\\nFor complex tasks, call write_todos first.\"\\r\n\\r\n# Step 2: Add file system  \\r\nfrom deepagents.middleware import FilesystemMiddleware\\r\nagent = create_deep_agent(middleware=[FilesystemMiddleware()])\\r\n\\r\n# Step 3: Add subagents\\r\nagent = create_deep_agent(subagents=[researcher, analyst])\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"You don't need all four pillars from day one. Add what solves your current bottleneck and iterate.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"The Middleware Architecture\"}),`\n`,(0,t.jsx)(e.p,{children:\"Deep agents use middleware to add capabilities. Each middleware component adds specific tools and prompt modifications:\"}),`\n`,(0,t.jsxs)(e.ul,{children:[`\n`,(0,t.jsxs)(e.li,{children:[(0,t.jsx)(e.strong,{children:\"TodoListMiddleware\"}),\" \\u2014 provides write_todos tool, adds planning prompts, tracks TODOs in agent state\"]}),`\n`,(0,t.jsxs)(e.li,{children:[(0,t.jsx)(e.strong,{children:\"FileSystemMiddleware\"}),\" \\u2014 adds file tools (ls, read, write, glob), handles automatic context eviction when tool results exceed threshold\"]}),`\n`,(0,t.jsxs)(e.li,{children:[(0,t.jsx)(e.strong,{children:\"SubAgentMiddleware\"}),\" \\u2014 provides task delegation tool, manages subagent lifecycle with context isolation\"]}),`\n`]}),`\n`,(0,t.jsx)(e.p,{children:\"You can also build custom middleware. A WeatherMiddleware might add a get_weather tool and modify the prompt to include weather-related instructions. This modular architecture means you add only the capabilities you need.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"The Four Pillars in Practice\"}),`\n`,(0,t.jsx)(e.h3,{children:\"Pillar 1: Planning Tools\"}),`\n`,(0,t.jsx)(e.p,{children:\"The most important tool does almost nothing. Claude Code's TODO list tool just stores strings. But it forces the agent to think before acting. The plan evolves dynamically \\u2014 when the agent discovers something unexpected, it updates the TODO list mid-execution.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`from langchain_core.tools import tool\\r\n\\r\n@tool\\r\ndef write_todos(todos: list[str]) -> str:\\r\n    \"\"\"\\r\n    Write or update your TODO list.\\r\n    Use this to break down complex tasks, track progress,\\r\n    and update your plan as you learn new information.\\r\n    Always write TODOs before starting complex work.\\r\n    \"\"\"\\r\n    return f\"Updated TODOs: {', '.join(todos)}\"\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"The value is not in what the tool does. It's in making the LLM call it. By making planning an explicit tool call, the agent externalizes its reasoning and creates checkpoints for adaptation. A real example: the agent starts with a TODO list for researching companies, discovers Google's Willow chip during research, and inserts a new TODO for deep-diving on Willow before continuing. The plan evolves as the agent learns, which is the key difference between shallow and deep execution. Without the planning tool, the agent would either miss the discovery entirely or get sidetracked and abandon the original task.\"}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-mermaid\",children:`flowchart TB\\r\n    Start([\"Start: Receive Task\"]) --> Plan[\"Write TODOs<br/>Planning Phase\"]\\r\n    Plan --> Loop{\"For Each TODO\"}\\r\n    Loop -->|\"Next TODO\"| Complex{\"Is Complex?\"}\\r\n    Complex -->|\"Yes\"| Spawn[\"Spawn Subagent\"]\\r\n    Spawn --> SubExec[\"Subagent Executes<br/>in Isolation\"]\\r\n    SubExec --> StoreFile1[\"Store Result<br/>in File\"]\\r\n    Complex -->|\"No\"| Direct[\"Execute Tool<br/>Directly\"]\\r\n    Direct --> StoreFile2[\"Store Result<br/>in File\"]\\r\n    StoreFile1 --> Update[\"Update TODOs<br/>Based on Learnings\"]\\r\n    StoreFile2 --> Update\\r\n    Update --> Check{\"All TODOs<br/>Complete?\"}\\r\n    Check -->|\"No\"| Loop\\r\n    Check -->|\"Yes\"| Synth[\"Synthesize<br/>from Files\"]\\r\n    Synth --> Final([\"Final Response\"])\\r\n\\r\n    style Plan fill:#50c878,color:#fff\\r\n    style Spawn fill:#ffd700,color:#000\\r\n    style StoreFile1 fill:#ff6b6b,color:#fff\\r\n    style StoreFile2 fill:#ff6b6b,color:#fff\\r\n    style Synth fill:#4a90e2,color:#fff\\r\n    style Final fill:#50c878,color:#fff\n`})}),`\n`,(0,t.jsx)(e.h3,{children:\"Pillar 2: File Systems\"}),`\n`,(0,t.jsx)(e.p,{children:\"Context windows are big now \\u2014 200k tokens, some models even claim 1M+. But you will still hit limits. Here's the math: a research task with 3 companies generates search results at 30k tokens per company, website content at 25k each, and analysis at 10k each. That's 175k tokens before you even start writing. You cannot cram everything into the context window.\"}),`\n`,(0,t.jsx)(e.p,{children:\"File systems solve this by writing findings to files as they're discovered, then reading only what's needed for the current step. The agent writes research results to company_X_research.md, reads only the relevant file when generating a cover letter. This keeps context manageable and focused. Think of it like a human researcher taking notes \\u2014 you don't keep every source in your head simultaneously, you reference them when needed.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Deep agents support three file system backends:\"}),`\n`,(0,t.jsx)(e.p,{children:\"Deep agents support multiple file system backends with different tradeoffs:\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"StateBackend (default)\"}),\" \\u2014 ephemeral, in-memory files. Files exist only during the conversation. Fast, no persistence needed. Perfect for single-session tasks and temporary workspaces.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"StoreBackend\"}),\" \\u2014 persistent across sessions. Files saved permanently and available in future conversations. Perfect for user preferences and learned knowledge that should accumulate over time.\"]}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`from deepagents.backends import StoreBackend\\r\nfrom langgraph.store.memory import InMemoryStore\\r\n\\r\nstore = InMemoryStore()\\r\nagent = create_deep_agent(backend=StoreBackend(), store=store)\n`})}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"CompositeBackend\"}),\" \\u2014 mix of both strategies using path-based routing. Most files are temporary, but specific paths like \",(0,t.jsx)(e.code,{children:\"/memories/\"}),\" or \",(0,t.jsx)(e.code,{children:\"/knowledge/\"}),\" are persisted.\"]}),`\n`,(0,t.jsx)(e.pre,{children:(0,t.jsx)(e.code,{className:\"language-python\",children:`backend = CompositeBackend(\\r\n    default=StateBackend(),\\r\n    routes={\"/memories/\": StoreBackend(), \"/knowledge/\": StoreBackend(), \"/temp/\": StateBackend()}\\r\n)\\r\nagent = create_deep_agent(backend=backend)\n`})}),`\n`,(0,t.jsx)(e.p,{children:\"Additionally, automatic context eviction middleware detects large tool results exceeding a threshold (default 5000 tokens) and writes them to files, replacing the context with a pointer reference. The agent can read the file later if needed, but the active context stays clean and focused.\"}),`\n`,(0,t.jsx)(e.h3,{children:\"Pillar 3: Subagents\"}),`\n`,(0,t.jsx)(e.p,{children:\"Subagents keep context isolated and clean. The main agent orchestrates without getting bogged down in details. Research subagent #1 researches company 1 in isolation. Research subagent #2 does the same for company 2. Each has a clean, focused context with its own system prompt and tool set.\"}),`\n`,(0,t.jsx)(e.p,{children:\"The shared file system is what makes this powerful. Subagent #1 writes findings to company1.md. Subagent #2 writes to company2.md. The main agent reads both files to synthesize the final output. No information is lost in handoffs because everything is stored in a common location that all agents can access.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Each subagent can also use a different model \\u2014 use GPT-4o for complex reasoning tasks and GPT-4o-mini for simpler research work. This gives you control over cost, latency, and quality at the subagent level rather than applying one model to everything.\"}),`\n`,(0,t.jsx)(e.h2,{children:\"Real-World Use Cases\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Deep Research Assistant:\"}),' Takes a research question like \"quantum computing applications in drug discovery,\" breaks it into subtopics, searches each one, spawns subagents for deep dives on specific papers, and synthesizes everything into a comprehensive report with citations.']}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Coding Assistant:\"}),\" Manages complex coding projects by understanding requirements, planning implementation steps, writing code across multiple files, running tests, and iterating based on errors \\u2014 all while keeping each file's context isolated and using the file system for cross-reference.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Job Application Assistant:\"}),\" Finds job openings, researches each company deeply (culture, values, recent news), and writes highly personalized cover letters that reference specific company details. The with-subagents approach means each company gets dedicated research context without polluting the main agent's workspace.\"]}),`\n`,(0,t.jsx)(e.h2,{children:\"Context Engineering\"}),`\n`,(0,t.jsx)(e.p,{children:\"Context engineering is the art of filling the context window with just the right information. Deep agents use several strategies:\"}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Dynamic loading.\"}),\" Don't load everything upfront. Use file operations to find relevant files and read only what's needed for the current step. Instead of loading all research into the prompt, the agent uses \",(0,t.jsx)(e.code,{children:\"ls\"}),\", \",(0,t.jsx)(e.code,{children:\"glob\"}),\", and \",(0,t.jsx)(e.code,{children:\"grep\"}),\" to find relevant files and reads only what's necessary.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Hierarchical context.\"}),\" Subagents isolate context naturally. The main agent never sees the raw 100 pages of research, only summaries and file pointers. Each subagent gets a clean, focused context for its specific task.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Automatic eviction.\"}),\" Middleware detects large tool results exceeding a threshold and automatically writes them to files, replacing the context with a pointer reference. The agent can read the file later if needed, but the active context stays clean.\"]}),`\n`,(0,t.jsxs)(e.p,{children:[(0,t.jsx)(e.strong,{children:\"Semantic search vs file systems.\"}),\" Vector databases are good for finding conceptually related information but bad for precise retrieval. File systems excel at exact matches, code, and structured data. Best practice is to use both.\"]}),`\n`,(0,t.jsx)(e.h2,{children:\"The Bottom Line\"}),`\n`,(0,t.jsx)(e.p,{children:\"The solution is not a different algorithm. It is the same algorithm with four architectural additions: planning, files, subagents, and better prompts. Deep agents are not magic \\u2014 they are traditional agents with architectural improvements that make them capable of handling real, complex work.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Start simple. Use traditional agents for simple tasks. Upgrade to deep agents when you hit the limits. Build incrementally: add planning first, then files, then subagents. See what you actually need. Most importantly, ship it. The perfect agent architecture does not exist. The one that solves your users' problems does.\"})]})}function h(n={}){let{wrapper:e}=n.components||{};return e?(0,t.jsx)(e,{...n,children:(0,t.jsx)(c,{...n})}):c(n)}return k(v);})();\n;return Component;"